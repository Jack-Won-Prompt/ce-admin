APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# 처방전 OCR 공급자 — 실제 선택은 관리자 '설정 > OCR 설정'(DB)에서, 아래는 DB 미설정 시 기본값
OCR_PROVIDER=textract
# AWS Textract 사용 시: 위 AWS_ACCESS_KEY_ID/SECRET 채우고 리전을 서울로(권장) 설정
# AWS_DEFAULT_REGION=ap-northeast-2
# OCR_TEXTRACT_ENABLED=          # 비워두면 AWS 키 유무로 자동 판단(EC2 IAM Role 사용 시 true)

VITE_APP_NAME="${APP_NAME}"

# ── 바로빌 API ──────────────────────────────────────────────
BAROBILL_API_KEY=97DA71F1-1F7E-4036-B02C-A7C256EAE9E6
BAROBILL_CORP_NUM=2648141225

# 공급자 정보 (세금계산서 발행용)
BAROBILL_CORP_NAME=
BAROBILL_CEO_NAME=
BAROBILL_ADDR=
BAROBILL_BIZ_CLASS=
BAROBILL_BIZ_TYPE=
BAROBILL_INVOICER_EMAIL=
BAROBILL_TEL=

# 문자서비스 — 바로빌에 발신번호 사전 등록 필요
BAROBILL_SMS_SENDER=
BAROBILL_SMS_SENDER_NAME=

# e-Fax — 바로빌에 발신번호 사전 등록 필요
BAROBILL_FAX_SENDER=
BAROBILL_FAX_SENDER_NAME=

# NHIS 청구
NHIS_FAX_NUMBER=027270001
NHIS_EFAX_DRIVER=barobill

# 요양비 지급청구 위임장(별지 제19호의7) 자동채움 — 준요양기관/수령계좌 고정정보
DELEGATION_PROVIDER_NAME=
DELEGATION_PROVIDER_BIZ_NO=
DELEGATION_PROVIDER_CEO=
DELEGATION_PROVIDER_PHONE=
DELEGATION_ACCOUNT_RECEIVER=
DELEGATION_ACCOUNT_BANK=
DELEGATION_ACCOUNT_HOLDER=
DELEGATION_ACCOUNT_NUMBER=
DELEGATION_PERIOD_YEARS=5

# NICE 본인확인 서비스(신규 REST API) — 위임동의 서명 전 본인확인
# 자격증명 3개가 모두 채워지면 자동 활성화되고 서명 전 본인확인이 강제됨(NICE_ENFORCE 로 조정).
# ※ 운영 권장: 관리자 화면 '설정 > 본인확인 설정'에서 입력하면 DB에 저장(비밀키 암호화)되고
#    아래 .env 값보다 우선 적용된다. 여기 값은 최초 시드/폴백용.
NICE_CLIENT_ID=
NICE_CLIENT_SECRET=
NICE_PRODUCT_ID=
# NICE_ENFORCE=true          # 비워두면 자격증명 유무에 따라 자동 결정
# NICE_API_BASE=https://svc.niceapi.co.kr:22001
# NICE_STANDARD_URL=https://nice.checkplus.co.kr/CheckPlusSafeModel/service.cb
# NICE_HTTP_TIMEOUT=10       # NICE API 호출 타임아웃(초)
# NICE_MATCH_NAME=true
# NICE_MATCH_BIRTH=true

# Withworks 물류 콜백 수신용 공유 비밀 — 없으면 콜백을 503 으로 거절한다
# WITHWORKS_WEBHOOK_SECRET=

# 로그인 문자 인증(2차 인증) 사용 여부 — 웹 관리자 화면과 모바일 앱이 같은 값을 본다.
# ※ 운영 권장: 관리자 화면 '설정 > 서비스 연동 설정 > 로그인' 탭에서 켜고 끄면 DB에 저장되어 아래 값보다 우선한다.
LOGIN_OTP_ENABLED=true
